# ─────────────────────────────────────────────────────────────
#  Copia este archivo como .env y rellena los valores reales
#  NUNCA subas .env al repositorio (está en .gitignore)
# ─────────────────────────────────────────────────────────────

# ── Imágenes Docker ────────────────────────────────────────────
AUTH_SERVICE_IMAGE=ghcr.io/patrici-a/patricia-auth-service:latest
PROFILE_SERVICE_IMAGE=ghcr.io/patrici-a/matchpuff-profile-service:latest
# SERVICIO_3_IMAGE=ghcr.io/patrici-a/nombre-servicio:latest

# ── JWT (compartido entre auth-service, Kong y todos los servicios) ──
JWT_SECRET=cambia-esto-por-un-secreto-seguro-de-minimo-32-chars
JWT_EXPIRATION=900000

# ── Redis ──────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── MongoDB (profile-service) ──────────────────────────────────
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/patricia

# ── Email (auth-service) ───────────────────────────────────────
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=tu-app-password-de-gmail
