# ─────────────────────────────────────────────────────────────
#  Copia este archivo como .env y rellena los valores reales
#  NUNCA subas .env al repositorio (está en .gitignore)
# ─────────────────────────────────────────────────────────────

# ── URLs de microservicios (Kong las usa para enrutar) ─────────
URL_AUTH=http://localhost:8800
URL_PROFILE=http://localhost:8080
URL_HANGOUT=http://localhost:8080
URL_CHAT=http://localhost:8080
URL_NOTIFICATION=http://localhost:8080
URL_GAMIFICATION=http://localhost:8080
URL_FEED_SEARCH=http://localhost:8080
URL_MATCHING=http://localhost:8080
URL_GEO=http://localhost:8080
URL_EVENTS=http://localhost:8080
URL_ANALYTICS=http://localhost:8080
URL_SUPPORT=http://localhost:8080

# ── JWT (compartido entre Kong, auth-service y todos los servicios) ──
JWT_SECRET=cambia-esto-por-un-secreto-seguro-de-minimo-32-chars
