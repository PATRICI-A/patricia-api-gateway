# ─────────────────────────────────────────────────────────────
#  Copia este archivo como .env y rellena los valores reales
#  NUNCA subas .env al repositorio (está en .gitignore)
# ─────────────────────────────────────────────────────────────

# ── Imágenes Docker (ECR, Docker Hub, GHCR, etc.) ─────────────
AUTH_SERVICE_IMAGE=ghcr.io/tu-org/patricia-auth-service:latest
USER_SERVICE_IMAGE=ghcr.io/tu-org/patricia-user-service:latest
REGISTRATION_SERVICE_IMAGE=ghcr.io/tu-org/patricia-registration-service:latest
# SERVICIO_4_IMAGE=ghcr.io/tu-org/patricia-servicio4:latest

# ── Redis ──────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=cambia-esto-por-un-secreto-seguro-de-minimo-32-chars
JWT_EXPIRATION=900000

# ── MongoDB (user-service) ─────────────────────────────────────
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/patricia

# ── Email (auth-service) ───────────────────────────────────────
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=tu-app-password-de-gmail
